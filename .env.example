# Supabase — copie este arquivo para .env.local e preencha com os valores
# do seu projeto (Project Settings > API no painel do Supabase).
# NUNCA faça commit de .env.local nem de valores reais neste arquivo.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service_role (Project Settings > API > service_role secret) —
# usada só no servidor pelo webhook de pagamento, pra liberar créditos e
# assinatura ignorando RLS. NUNCA expor com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (Suas integrações > [app] > Credenciais) — pagamentos de
# planos (assinatura) e créditos extras (cobrança avulsa).
MERCADOPAGO_ACCESS_TOKEN=
# Suas integrações > [app] > Webhooks > chave secreta — só existe depois
# de configurar a URL do webhook (ver app/api/webhooks/mercadopago/route.ts).
MERCADOPAGO_WEBHOOK_SECRET=
